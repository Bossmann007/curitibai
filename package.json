{
  "name": "curitibai-mcp",
  "version": "0.68.0",
  "description": "Unofficial read-only MCP server for public Curitiba (Brazil) city data. Not affiliated with Prefeitura de Curitiba.",
  "mcpName": "io.github.Bossmann007/curitibai",
  "license": "(Apache-2.0 AND ODbL-1.0)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "curitiba",
    "brazil",
    "open-data",
    "dados-abertos"
  ],
  "homepage": "https://github.com/Bossmann007/curitibai#readme",
  "bugs": {
    "url": "https://github.com/Bossmann007/curitibai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bossmann007/curitibai.git"
  },
  "type": "module",
  "bin": {
    "curitibai-mcp": "dist/server.js"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "docs/licences.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "contracts:update": "CURITIBAI_UPDATE_CONTRACTS=1 vitest run test/contracts.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
