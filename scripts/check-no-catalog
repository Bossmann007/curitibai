#!/usr/bin/env bash
# Fails if git tracks a file named carta-servicos.json (any folder, any letter case), other than the synthetic
# test fixture. The user's copy of the city services catalog must never be committed, even with `git add -f`.
# Also fails if git tracks a URBS daily export (linhas, pontosLinha, tabelaLinha, pois or any other kind): a file
# named YYYY_MM_DD_<anything>.json or .json.xz (any folder, any letter case), with no exemption (the synthetic URBS fixtures have no date in their names).
# Also fails if git tracks anything inside a folder named events or phones (the collector's output,
# CURITIBAI_DATA_DIR/events/ and CURITIBAI_DATA_DIR/phones/),
# or an HTML capture (.html, .htm, .mhtml, .har) outside test/fixtures/: real pages of the events site are never committed.
# The fixture is exempt only as a regular file (mode 100644) whose staged content matches the pinned sha256,
# and the work-tree file at the fixture path, when present, must match the pinned sha256 too.
# Usage: scripts/check-no-catalog [repo-dir]   (default: this repo; must be the top of a git checkout)
# Exit: 0 OK, 1 a catalog, URBS, events or HTML capture file is tracked or the fixture is modified in the work tree,
#       2 not a directory, not the top of a git checkout, or no temp file (cannot tell what is tracked).
set -euo pipefail

fail2() {
  echo "check-no-catalog: FAIL: $*" >&2
  exit 2
}

dir=${1:-$(dirname "$0")/..}
CDPATH="" cd -- "$dir" >/dev/null 2>&1 || fail2 "not a directory (or not accessible): $dir"
top=$(git rev-parse --show-toplevel 2>/dev/null) || fail2 "not a git checkout, cannot tell what is tracked"
[[ "$top" == "$(pwd -P)" ]] || fail2 "not the top of a git checkout (top is $top)"

allowed="test/fixtures/carta_servicos_synthetic/carta-servicos.json"
# sha256 of the synthetic fixture: update it in the same commit when the fixture changes on purpose.
allowed_sha256="ddfe82e5a457e50ff66d641a873156c831d391ec3eef8d494d8d35cca9ecc577"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -d' ' -f1
}

index=$(mktemp "${TMPDIR:-/tmp}/check-no-catalog.XXXXXX") || fail2 "cannot create a temp file"
trap 'rm -f "$index"' EXIT
git ls-files -s -z >"$index" || fail2 "git ls-files failed, cannot tell what is tracked"

name_re='/carta-servicos\.json$'
urbs_re='/[0-9]{4}_[0-9]{2}_[0-9]{2}_[^/]*\.json(\.xz)?$'
events_re='/(events|phones)/'
capture_re='\.(html?|mhtml|har)$'
found=""
urbs_found=""
events_found=""
capture_found=""
while IFS= read -r -d '' entry; do
  path=${entry#*$'\t'}
  shopt -s nocasematch
  if [[ "/$path" =~ $name_re ]]; then match=1; else match=0; fi
  if [[ "/$path" =~ $urbs_re ]]; then urbs=1; else urbs=0; fi
  if [[ "/$path" =~ $events_re ]]; then events=1; else events=0; fi
  if [[ "$path" =~ $capture_re && "$path" != test/fixtures/* ]]; then capture=1; else capture=0; fi
  shopt -u nocasematch
  [[ $events == 1 ]] && events_found+="  $path"$'\n'
  [[ $capture == 1 ]] && capture_found+="  $path"$'\n'
  if [[ $urbs == 1 ]]; then
    urbs_found+="  $path"$'\n'
    continue
  fi
  [[ $match == 1 ]] || continue
  if [[ "$path" == "$allowed" ]]; then
    read -r mode blob _ <<<"${entry%%$'\t'*}"
    if [[ $mode == 100644 && "$(git cat-file blob "$blob" | sha256)" == "$allowed_sha256" ]]; then
      continue
    fi
  fi
  found+="  $path"$'\n'
done <"$index"

status=0
if [[ -n "$found" ]]; then
  {
    echo "check-no-catalog: FAIL: git tracks a city services catalog file (private, never committed):"
    printf '%s' "$found"
    echo "Fix: git rm --cached <path> (keeps your local copy), then commit."
  } >&2
  status=1
fi
if [[ -n "$urbs_found" ]]; then
  {
    echo "check-no-catalog: FAIL: git tracks a URBS daily export (YYYY_MM_DD_*.json; the user's download, never committed):"
    printf '%s' "$urbs_found"
    echo "Fix: git rm --cached <path> (keeps your local copy), then commit."
  } >&2
  status=1
fi
if [[ -n "$events_found" ]]; then
  {
    echo "check-no-catalog: FAIL: git tracks a file in an events or phones folder (the collector's output, never committed):"
    printf '%s' "$events_found"
    echo "Fix: git rm --cached <path> (keeps your local copy), then commit."
  } >&2
  status=1
fi
if [[ -n "$capture_found" ]]; then
  {
    echo "check-no-catalog: FAIL: git tracks an HTML capture outside test/fixtures/ (real pages are never committed):"
    printf '%s' "$capture_found"
    echo "Fix: git rm --cached <path> (keeps your local copy), then commit."
  } >&2
  status=1
fi
# The index check misses an edit that is not staged yet: check the work-tree copy too (raw bytes, LF as pinned).
if [[ (-e "$allowed" || -L "$allowed") && (! -f "$allowed" || "$(sha256 <"$allowed")" != "$allowed_sha256") ]]; then
  {
    echo "check-no-catalog: FAIL: fixture modified in the work tree: $allowed"
    echo "Fix: git checkout -- $allowed, or update allowed_sha256 here if the change is on purpose."
  } >&2
  status=1
fi
[[ $status == 0 ]] && echo "check-no-catalog: OK"
exit "$status"
