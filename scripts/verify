#!/usr/bin/env bash
# Exit 0 = built. Needs no network except `npm ci` when the npm cache is cold.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n== %s\n' "$*"; }

step "no tracked city services catalog (carta-servicos.json), URBS export (YYYY_MM_DD_*.json), collector output (events/, phones/) or HTML capture"
scripts/check-no-catalog

step "relative Markdown links and anchors resolve (README.md, CONTRIBUTING.md, SECURITY.md, CHANGELOG.md, docs/*.md)"
node scripts/check-links.mjs

step "release: package.json version is the newest CHANGELOG release; tags vX.Y.Z when the clone has tags (docs/adr/0006)"
node scripts/check-release.mjs

step "npm ci --ignore-scripts (no dependency install script runs; none is needed)"
npm ci --ignore-scripts --no-audit --no-fund --prefer-offline

step "tsc --noEmit"
npx tsc --noEmit

step "eslint"
npx eslint .

step "vitest run"
npx vitest run

step "citizen eval summary (the questions themselves ran in vitest above: test/eval/citizenEval.test.ts)"
node scripts/eval-summary.mjs

step "build"
npm run --silent build

step "package contents: npm pack --dry-run --json holds only dist/*.js, README.md, LICENSE, CHANGELOG.md, docs/licences.md and package.json; no data-local/, tests, fixtures, src/, .env* or *.local; required licence notices (REQUIRED_NOTICES) present; packed size printed, under 252,000 bytes"
node scripts/check-pack.mjs

step "stdio smoke test (tools/list of the 27 tools; useful_phones, city_services_search, city_service_guide open_step fallback, bus_departures, bus_stops_near, next_buses_near, bus_route_between and city_points_search on the synthetic fixtures; events_search with no copy and CURITIBAI_REMOTE_DATA=0; city_facilities_search list types; CURITIBAI_REMOTE_DATA=maybe stops the server at start)"
node scripts/smoke.mjs

step "bus_stops_near timing guard (17,496 generated stop rows, budget about 100 ms, fails over 400 ms)"
node scripts/perf-bus-stops-near.mjs

step "next_buses_near timing guard (17,496 generated stop rows and 71,085 departures, budget about 150 ms, fails over 600 ms)"
node scripts/perf-next-buses-near.mjs

step "bus_route_between timing guard (17,496 generated stop rows, radius 1 km, budget about 100 ms, fails over 400 ms)"
node scripts/perf-bus-route-between.mjs

step "local_csv_summary timing guard (2,000 distinct 8,000-character values, budget 2 s per call)"
node scripts/perf-local-csv-summary.mjs

echo
echo "verify: OK"

# Reported separately: never changes the exit code above. CURITIBAI_SKIP_AUDIT=1 skips it (CI sets it).
step "npm audit --omit=dev --audit-level=high (separate, needs network)"
if [[ "${CURITIBAI_SKIP_AUDIT:-}" == 1 ]]; then
  echo "audit: SKIPPED (CURITIBAI_SKIP_AUDIT=1)"
elif curl -fsS -m 5 -o /dev/null https://registry.npmjs.org/ 2>/dev/null; then
  if npm audit --omit=dev --audit-level=high; then
    echo "audit: OK"
  else
    echo "audit: FINDINGS (not part of verify result)"
  fi
else
  echo "audit: SKIPPED (network unavailable)"
fi
